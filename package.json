    "test:one-shot-audio": "node --import tsx _qa/one-shot-audio.ts",
    "test:protocol": "TMPDIR=/private/tmp tsx _qa/protocol.ts",
    "test:danger": "TMPDIR=/private/tmp tsx _qa/danger-director.ts",
    "test:ending": "TMPDIR=/private/tmp tsx _qa/ending-director.ts",
    "test:campaign": "TMPDIR=/private/tmp tsx _qa/pacing-and-endings.ts",
    "test:character-debut": "TMPDIR=/private/tmp tsx _qa/character-debut.ts",
    "test:domain": "TMPDIR=/private/tmp tsx _qa/domain-rules.ts",
    "test:stage-narrative": "TMPDIR=/private/tmp tsx _qa/stage-narrative.ts",
    "test:authority-shadow": "node --import tsx _qa/authority-shadow.ts",
